<!--
    Main.xaml — window shell.

    Layout, top to bottom:

        title bar strip      identity and machine state
        spec strip           CPU / RAM / OS / GPU, one line, monospace
        body                 sidebar (8 folders)  |  card list
        footer               3 bands: operation + count / bar / summary

    The card list is empty in this file. Main.ps1 builds one card per script and
    inserts them into #CardHost, because a card's control depends on the card
    type (checkbox, dropdown or button) and WPF data binding in PowerShell is
    heavier than building the controls directly.

    Everything referenced with DynamicResource lives in Theme.xaml, which is
    merged in after this file is parsed.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AkariOS Ultimate"
    Height="880" Width="1360"
    MinHeight="620" MinWidth="1040"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Paper}"
    FontFamily="{DynamicResource Sans}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!-- F5 refresh is bound in Main.ps1. A loose XAML file loaded through
         XamlReader cannot resolve the ApplicationCommands type name, so the
         key binding has to be added in code with a real CommandInfo object. -->

    <DockPanel>

        <!-- ============================================================ -->
        <!-- Title strip                                                   -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome}">
            <Grid Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="AKARIOS ULTIMATE"
                           Foreground="{DynamicResource OnChrome}"
                           FontSize="{DynamicResource SizeTitle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- #Privilege shows ADMIN / USER; elevation is required. -->
                <TextBlock x:Name="Privilege" Grid.Column="1"
                           Margin="14,0,0,0"
                           Foreground="{DynamicResource OnChrome}"
                           Opacity="0.75"
                           FontFamily="{DynamicResource Mono}"
                           FontSize="{DynamicResource SizeSmall}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- #RestartBadge appears only when a tweak needs a reboot. -->
                    <TextBlock x:Name="RestartBadge"
                               Text="&#x27F3; RESTART REQUIRED"
                               Foreground="{DynamicResource OnChrome}"
                               FontFamily="{DynamicResource Mono}"
                               FontSize="{DynamicResource SizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Visibility="Collapsed"/>
                    <Button x:Name="BtnRevertAll" Content="Revert All"
                            Style="{DynamicResource Button}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnApply" Content="Apply"
                            Style="{DynamicResource Button.Solid}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Spec strip                                                    -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Rule}"
                BorderThickness="0,0,0,1"
                Padding="16,5">
            <!-- Filled by Main.ps1. Fixed-width so values line up in a column. -->
            <TextBlock x:Name="SpecStrip"
                       FontFamily="{DynamicResource Mono}"
                       FontSize="{DynamicResource SizeSmall}"
                       Foreground="{DynamicResource Ink}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- ============================================================ -->
        <!-- Body                                                          -->
        <!-- ============================================================ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ~~~~~~~~~~ Sidebar ~~~~~~~~~~ -->
            <DockPanel Grid.Column="0" Background="{DynamicResource Paper}">

                <TextBlock DockPanel.Dock="Top"
                           Text="CATEGORIES"
                           Style="{DynamicResource Text.Caption}"
                           Margin="16,12,16,6"/>

                <!-- #Search filters the card list and the sidebar counts. -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,8">
                    <TextBox x:Name="Search" Style="{DynamicResource TextBox}"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Sidebar" Margin="6,0,6,12"/>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Rule}"/>

            <!-- ~~~~~~~~~~ Cards ~~~~~~~~~~ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Paper}"
                        BorderBrush="{DynamicResource Rule}"
                        BorderThickness="0,0,0,1"
                        Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderTitle" Grid.Column="0"
                                   Style="{DynamicResource Text.Title}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="FolderMeta" Grid.Column="1"
                                   Style="{DynamicResource Text.Value}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Dim}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CardHost" Margin="12"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- Footer: three bands                                            -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource RuleStrong}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,8,18,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Band 1: what is running, and the operation count. -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OpName" Grid.Column="0"
                               Style="{DynamicResource Text.Label}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpCount" Grid.Column="1"
                               Style="{DynamicResource Text.Value}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Band 2: the bar, with percent and elapsed beside it. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="Bar" Grid.Column="0"
                                 Style="{DynamicResource Bar}"
                                 Value="0"/>
                    <TextBlock x:Name="BarPct" Grid.Column="1"
                               Style="{DynamicResource Text.Value}"
                               MinWidth="86"
                               Margin="12,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="—"/>
                </Grid>

                <!-- Band 3: last operation, and the controls. -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- #OpDetail shows the most recent intercepted command. -->
                    <TextBlock x:Name="OpDetail" Grid.Column="0"
                               Style="{DynamicResource Text.Micro}"
                               FontFamily="{DynamicResource Mono}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="Summary"
                                   Style="{DynamicResource Text.Micro}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnCancel" Content="Cancel"
                                Style="{DynamicResource Button}"
                                Margin="0,0,8,0"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </DockPanel>
</Window>
