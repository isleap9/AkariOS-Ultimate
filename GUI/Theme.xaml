<!--
    Theme.xaml — monochrome palette and shared control styles.

    There is no colour in this file except black, white and alpha variants of
    them. State is never carried by hue; it is carried by inversion, weight,
    rules and glyphs. See OPENCODE.md section 8 for the full state table.

    Loaded by Main.ps1 as a ResourceDictionary and merged into the window.
    Because it is merged AFTER the window XAML is parsed, everything in here is
    referenced with DynamicResource rather than StaticResource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================== -->
    <!-- Palette                                                          -->
    <!-- ============================================================== -->

    <Color x:Key="InkColor">#FF000000</Color>
    <Color x:Key="PaperColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Ink"        Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="Paper"      Color="{StaticResource PaperColor}"/>

    <!-- Inverted: applied / selected state. -->
    <SolidColorBrush x:Key="InkInvert"  Color="{StaticResource PaperColor}"/>

    <!-- Alpha steps for rules, disabled rows and secondary text. -->
    <SolidColorBrush x:Key="RuleStrong"  Color="#FF000000"/>
    <SolidColorBrush x:Key="Rule"        Color="#33000000"/>
    <SolidColorBrush x:Key="RuleFaint"   Color="#1A000000"/>
    <SolidColorBrush x:Key="Dim"         Color="#66000000"/>
    <SolidColorBrush x:Key="Dimmer"      Color="#40000000"/>

    <!-- Panel fills, alternating to keep long lists readable in one hue. -->
    <SolidColorBrush x:Key="Surface"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt"  Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Chrome"      Color="#FF000000"/>
    <SolidColorBrush x:Key="OnChrome"    Color="#FFFFFFFF"/>

    <!-- ============================================================== -->
    <!-- Typography                                                       -->
    <!-- ============================================================== -->

    <FontFamily x:Key="Sans">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="SizeMicro">10</sys:Double>
    <sys:Double x:Key="SizeSmall">11</sys:Double>
    <sys:Double x:Key="SizeBody">12.5</sys:Double>
    <sys:Double x:Key="SizeTitle">15</sys:Double>
    <sys:Double x:Key="SizeDisplay">22</sys:Double>

    <!-- ============================================================== -->
    <!-- Reusable text styles                                            -->
    <!-- ============================================================== -->

    <!-- TextOptions is attached and read-only, so it cannot be set from a
         Setter. Subpixel rendering is switched on once on the window instead. -->
    <Style x:Key="Text.Micro" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize"     Value="{DynamicResource SizeMicro}"/>
        <Setter Property="Foreground"   Value="{DynamicResource Dim}"/>
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize"    Value="{DynamicResource SizeBody}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontSize"   Value="{DynamicResource SizeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Section caption: uppercase, letter-spaced, used in the sidebar and
         above each footer band. -->
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============================================================== -->
    <!-- Progress bar                                                     -->
    <!-- ============================================================== -->

    <!-- A plain two-tone bar: black fill on white, hairline outline. The
         indeterminate animation is the stock one, which is a sweeping block,
         so it stays monochrome without extra work. -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height"      Value="10"/>
        <Setter Property="Background"  Value="{DynamicResource Paper}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Minimum"     Value="0"/>
        <Setter Property="Maximum"     Value="100"/>
    </Style>

    <!-- ============================================================== -->
    <!-- Controls                                                        -->
    <!-- ============================================================== -->

    <!-- Square, unadorned checkbox. The tick is the only state cue besides
         the row inversion applied in code. -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize"   Value="{DynamicResource SizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="62"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Edge"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover is a fill change, not a colour change. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Edge" Property="Background"
                                    Value="{DynamicResource SurfaceAlt}"/>
                        </Trigger>
                        <!-- Primary action: solid black, white text. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Dimmer}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solid variant for Apply / Run / the current destructive action. -->
    <Style x:Key="Button.Solid" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="Background"  Value="{DynamicResource Chrome}"/>
        <Setter Property="Foreground"  Value="{DynamicResource OnChrome}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome}"/>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
        <Setter Property="FontSize"   Value="{DynamicResource SizeSmall}"/>
        <Setter Property="Padding"    Value="4,2"/>
        <Setter Property="MinWidth"   Value="150"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        <Setter Property="FontSize"   Value="{DynamicResource SizeSmall}"/>
        <Setter Property="Padding"    Value="4,3"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

</ResourceDictionary>
