<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akari" Width="1000" Height="660" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Tx}">
  <Window.Resources>
    <!-- Ink tokens. Paper later = same keys, different colors. -->
    <SolidColorBrush x:Key="Bg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="S1" Color="#141414"/>
    <SolidColorBrush x:Key="S2" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Bd" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Tx" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Mu" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Inv" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="InvT" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Warn" Color="#D9A441"/>
    <SolidColorBrush x:Key="Bad" Color="#E5645A"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Mu}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnP" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Inv}"/>
      <Setter Property="Foreground" Value="{DynamicResource InvT}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Inv}"/>
    </Style>

    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="0,1">
              <Border x:Name="B" CornerRadius="4" Background="Transparent" Padding="14,7">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <Rectangle x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource Inv}" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><SkewTransform AngleY="-14"/></Rectangle.RenderTransform>
              </Rectangle>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource S2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource S2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" BorderThickness="1" BorderBrush="{DynamicResource Bd}" CornerRadius="4"
                    Background="Transparent" Padding="11,4">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Mu}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Inv}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Inv}"/>
                <Setter Property="Foreground" Value="{DynamicResource InvT}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Flat" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource S1}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Tx}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Mu}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Bd}" CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{DynamicResource S1}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,1,0" Padding="10,16,10,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <Image x:Name="Logo" Width="28" Height="28">
            <Image.Clip><EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/></Image.Clip>
          </Image>
          <TextBlock Text="Akari" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="Nav"/>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="104"/>
      </Grid.RowDefinitions>

      <Border Padding="16,12" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBox x:Name="Search" Style="{StaticResource Flat}" ToolTip="Search all scripts"/>
          <TextBlock Text="Search all scripts" Foreground="{DynamicResource Mu}" Margin="11,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Page" Margin="16,14">
          <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

          <!-- Home page: host header + spec card grid -->
          <StackPanel x:Name="HomePanel" Visibility="Collapsed">
            <DockPanel x:Name="HomeHeader" Margin="0,0,0,16">
              <!-- copy specs button (right side) -->
              <Button x:Name="CopySpecs" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Copy specs"
                      ToolTip="Copy all specs as text" IsEnabled="False" Style="{StaticResource Btn}"/>
              <StackPanel>
                <TextBlock x:Name="HostName" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Tx}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HostSub" FontSize="13" Foreground="{DynamicResource Mu}" Margin="0,4,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel x:Name="Cards" Orientation="Horizontal"/>
          </StackPanel>

          <!-- Win32PrioritySeparation tuner (Advanced page) -->
          <Border x:Name="Tuner" Visibility="Collapsed" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Bd}"
                  BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Win32PrioritySeparation" FontWeight="Medium"/>
              <TextBlock Text="How long each app gets the CPU, and how much the window in front is favored."
                         Foreground="{DynamicResource Mu}" FontSize="12.5" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Quantum length" Foreground="{DynamicResource Mu}" FontSize="12" Margin="0,0,0,4"/>
                  <WrapPanel>
                    <RadioButton x:Name="QL_0" GroupName="QL" Content="Default" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="QL_1" GroupName="QL" Content="Long" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="QL_2" GroupName="QL" Content="Short" Style="{StaticResource Chip}"/>
                  </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Quantum type" Foreground="{DynamicResource Mu}" FontSize="12" Margin="0,0,0,4"/>
                  <WrapPanel>
                    <RadioButton x:Name="QT_0" GroupName="QT" Content="Default" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="QT_1" GroupName="QT" Content="Variable" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="QT_2" GroupName="QT" Content="Fixed" Style="{StaticResource Chip}"/>
                  </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Foreground boost" Foreground="{DynamicResource Mu}" FontSize="12" Margin="0,0,0,4"/>
                  <WrapPanel>
                    <RadioButton x:Name="FB_0" GroupName="FB" Content="None" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="FB_1" GroupName="FB" Content="Medium" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="FB_2" GroupName="FB" Content="High" Style="{StaticResource Chip}"/>
                  </WrapPanel>
                </StackPanel>
              </Grid>
              <DockPanel Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Tag="read" Content="Read current" Style="{StaticResource Btn}"/>
                  <Button Tag="def" Content="Default (0x02)" Style="{StaticResource Btn}"/>
                  <Button Tag="apply" Content="Apply" Style="{StaticResource BtnP}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="Hex" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock x:Name="Dec" Foreground="{DynamicResource Mu}" Margin="12,0,0,2" VerticalAlignment="Bottom"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- SvcHost split threshold tuner (Advanced page) -->
          <Border x:Name="SvcTuner" Visibility="Collapsed" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Bd}"
                  BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="SvcHost split threshold" FontWeight="Medium"/>
              <TextBlock Text="Controls how many svchost.exe processes Windows creates. Merging them saves memory, but one crash takes more services down. Restart to apply."
                         Foreground="{DynamicResource Mu}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <WrapPanel>
                <RadioButton x:Name="SV_0" GroupName="SV" Content="Windows default" Style="{StaticResource Chip}"/>
                <RadioButton x:Name="SV_1" GroupName="SV" Content="Match RAM" Style="{StaticResource Chip}"/>
                <RadioButton x:Name="SV_2" GroupName="SV" Content="Never split" Style="{StaticResource Chip}"/>
              </WrapPanel>
              <DockPanel Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Tag="read" Content="Read current" Style="{StaticResource Btn}"/>
                  <Button Tag="def" Content="Default" Style="{StaticResource Btn}"/>
                  <Button Tag="apply" Content="Apply" Style="{StaticResource BtnP}"/>
                </StackPanel>
                <TextBlock x:Name="SvcCur" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <StackPanel x:Name="Rows"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
        <TextBox x:Name="Log" Style="{StaticResource Flat}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource Mu}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="16,8"/>
      </Border>
    </Grid>
  </Grid>
</Window>
